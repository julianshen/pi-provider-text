# pi-provider-text configuration
# Copy the values you need into your shell environment before starting pi.
# Only PI_TEXT_BASE_URL, PI_TEXT_API_KEY and PI_TEXT_MODELS are required.

# OpenAI-compatible base URL (usually ends in /v1).
PI_TEXT_BASE_URL=https://api.example.com/v1

# API key, sent as `Authorization: Bearer <key>`. Leave empty for keyless local servers.
PI_TEXT_API_KEY=sk-your-key

# Comma-separated model ids. Each entry may be `id` or `id=Display Name`.
# Use `=` (not `:`) for the display name so ids with colons (e.g. ollama tags
# like qwen2.5-coder:7b) stay intact.
PI_TEXT_MODELS=my-model=My Model

# ---- Optional ----
# Name of the env var that holds the key (default: PI_TEXT_API_KEY).
# PI_TEXT_API_KEY_ENV=MY_PROVIDER_TOKEN
# Provider key shown in the /model picker (default: text).
# PI_TEXT_PROVIDER_ID=text
# Human-readable provider name (default: Custom Text Provider).
# PI_TEXT_PROVIDER_NAME=My Provider
# Context window in tokens (default: 128000).
# PI_TEXT_CONTEXT_WINDOW=128000
# Max output tokens (default: 16384).
# PI_TEXT_MAX_TOKENS=16384
# Set true if the models expose reasoning/thinking (default: false).
# PI_TEXT_REASONING=false
# Set true if the models accept image input (default: false).
# PI_TEXT_INPUT_IMAGE=false
# Extra static headers as JSON (values may use pi's $ENV / !cmd syntax).
# PI_TEXT_HEADERS={"x-portkey-provider":"openai"}
# Per-million-token costs (default: 0 each).
# PI_TEXT_COST_INPUT=0
# PI_TEXT_COST_OUTPUT=0
# PI_TEXT_COST_CACHE_READ=0
# PI_TEXT_COST_CACHE_WRITE=0
